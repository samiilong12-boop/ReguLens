# ReguLens Environment Configuration (Template / Placeholders Only)
# Copy to .env for local development. NEVER commit .env to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]

# Database Connection (PostgreSQL 16+)
DATABASE_URL=postgresql+asyncpg://regulens_app:change_this_password@localhost:5432/regulens_dev
DATABASE_MIGRATION_URL=postgresql+asyncpg://regulens_migrator:change_this_admin_password@localhost:5432/regulens_dev

# JWT & Authentication Secret Keys
JWT_SECRET_KEY=change_this_to_a_minimum_32_character_random_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=regulens-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# AI Provider Configuration (Google Gemini / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=placeholder_api_key_for_gemini
OPENAI_API_KEY=placeholder_api_key_for_openai

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
